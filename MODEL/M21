      ],
      "source": [
        "AREAS = {\n",
        "    \"patch management\": [\"patch\", \"update\", \"vulnerability management\", \"unpatched\"],\n",
        "    \"security awareness\": [\"awareness\", \"training\", \"phishing simulation\", \"user education\"],\n",
        "    \"monitoring\": [\"monitoring\", \"siem\", \"alert\", \"logging\", \"detection\", \"visibility\"],\n",
        "    \"backup strategy\": [\"backup\", \"restore\", \"recovery point\", \"offline copy\", \"disaster recovery\"],\n",
        "    \"access control\": [\"access control\", \"least privilege\", \"permission\", \"mfa\", \"privilege\"],\n",
        "}\n",
        "\n",
        "def tag_report(text):\n",
        "    t = text.lower()\n",
        "    return [area for area, words in AREAS.items() if any(w in t for w in words)]\n",
        "\n",
        "path = input(\"Post-incident report file (press Enter to paste): \").strip()\n",
        "if path:\n",
        "    try:\n",
        "        text = open(path, encoding=\"utf-8\").read()\n",
        "    except OSError as e:\n",
        "        print(\"Could not read report:\", e)\n",
        "        text = \"\"\n",
        "else:\n",
        "    text = input(\"Report text: \")\n",
        "\n",
        "tags = tag_report(text)\n",
        "print(\"Improvement areas:\", \", \".join(tags) if tags else \"None detected\")\n"
      ]
    }
