      "source": [
        "from collections import defaultdict\n",
        "\n",
        "firewall = [{\"src\":\"198.51.100.7\",\"action\":\"ALLOW\",\"port\":443}]\n",
        "windows = [\n",
        "    {\"src\":\"198.51.100.7\",\"event\":\"FAILED_LOGIN\",\"user\":\"admin\"},\n",
        "    {\"src\":\"198.51.100.7\",\"event\":\"FAILED_LOGIN\",\"user\":\"admin\"},\n",
        "]\n",
        "vpn = [{\"src\":\"198.51.100.7\",\"event\":\"VPN_SUCCESS\",\"user\":\"admin\"}]\n",
        "\n",
        "failed = defaultdict(int)\n",
        "for e in windows:\n",
        "    if e[\"event\"] == \"FAILED_LOGIN\":\n",
        "        failed[(e[\"src\"], e[\"user\"])] += 1\n",
        "\n",
        "for e in vpn:\n",
        "    key = (e[\"src\"], e[\"user\"])\n",
        "    firewall_seen = any(f[\"src\"] == e[\"src\"] and f[\"action\"] == \"ALLOW\" for f in firewall)\n",
        "    if failed[key] >= 2 and firewall_seen:\n",
        "        print(\"SIEM CORRELATION ALERT:\", e[\"src\"], e[\"user\"],\n",
        "              \"had repeated Windows failures, firewall activity, and VPN success.\")\n",
        "    else:\n",
        "        print(\"No correlated brute-force alert for\", key)\n"
      ]
