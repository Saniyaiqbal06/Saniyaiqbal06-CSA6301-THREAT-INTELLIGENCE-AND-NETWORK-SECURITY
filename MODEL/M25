        "import hashlib\n",
        "from datetime import datetime\n",
        "\n",
        "def verify(records):\n",
        "    previous_hash = None\n",
        "    previous_time = None\n",
        "    for i, r in enumerate(records, 1):\n",
        "        timestamp = datetime.fromisoformat(r[\"timestamp\"])\n",
        "        content = f'{r[\"evidence_id\"]}|{r[\"action\"]}|{r[\"timestamp\"]}|{r[\"previous_hash\"]}'\n",
        "        expected = hashlib.sha256(content.encode()).hexdigest()\n",
        "\n",
        "        if r[\"previous_hash\"] != previous_hash:\n",
        "            return False, f\"Record {i}: broken previous-hash chain\"\n",
        "        if previous_time and timestamp < previous_time:\n",
        "            return False, f\"Record {i}: timestamp decreased\"\n",
        "        if r[\"hash\"] != expected:\n",
        "            return False, f\"Record {i}: record hash mismatch\"\n",
        "\n",
        "        previous_hash = r[\"hash\"]\n",
        "        previous_time = timestamp\n",
        "    return True, \"Chain is unbroken and timestamps are non-decreasing.\"\n",
        "\n",
        "records = []\n",
        "previous = None\n",
        "for i, action in enumerate([\"Collected\", \"Transferred\", \"Stored\"], 1):\n",
        "    ts = f\"2026-08-28T09:0{i}:00\"\n",
        "    base = f\"EVIDENCE-01|{action}|{ts}|{previous}\"\n",
        "    h = hashlib.sha256(base.encode()).hexdigest()\n",
        "    records.append({\"evidence_id\":\"EVIDENCE-01\",\"action\":action,\n",
        "                    \"timestamp\":ts,\"previous_hash\":previous,\"hash\":h})\n",
        "    previous = h\n",
        "\n",
        "ok, message = verify(records)\n",
        "print(\"VALID\" if ok else \"INVALID\", \"-\", message)\n"
      ]
    }
