            "{'src_ip': '10.0.0.20', 'payload': 'normal web request'} => ALLOW\n",
            "{'src_ip': '10.0.0.20', 'payload': 'evil_payload detected'} => BLOCK (IPS signature: MALWARE_TEST)\n",
            "{'src_ip': '10.0.0.10', 'payload': 'evil_payload from trusted test source'} => ALLOW (trusted-source whitelist)\n"
          ]
        }
      ],
      "source": [
        "TRUSTED_SOURCES = {\"10.0.0.10\"}\n",
        "\n",
        "SIGNATURES = {\n",
        "    \"MALWARE_TEST\": \"evil_payload\",\n",
        "    \"COMMAND_TEST\": \"cmd=/bin/sh\",\n",
        "    \"SQL_TEST\": \"union select\",\n",
        "}\n",
        "\n",
        "def inspect(packet):\n",
        "    src = packet.get(\"src_ip\", \"\")\n",
        "    payload = packet.get(\"payload\", \"\").lower()\n",
        "    if src in TRUSTED_SOURCES:\n",
        "        return \"ALLOW (trusted-source whitelist)\"\n",
        "    for name, pattern in SIGNATURES.items():\n",
        "        if pattern.lower() in payload:\n",
        "            return f\"BLOCK (IPS signature: {name})\"\n",
        "    return \"ALLOW\"\n",
        "\n",
        "packets = [\n",
        "    {\"src_ip\":\"10.0.0.20\",\"payload\":\"normal web request\"},\n",
        "    {\"src_ip\":\"10.0.0.20\",\"payload\":\"evil_payload detected\"},\n",
        "    {\"src_ip\":\"10.0.0.10\",\"payload\":\"evil_payload from trusted test source\"},\n",
        "]\n",
        "\n",
        "for p in packets:\n",
        "    print(p, \"=>\", inspect(p))\n"
      ]
