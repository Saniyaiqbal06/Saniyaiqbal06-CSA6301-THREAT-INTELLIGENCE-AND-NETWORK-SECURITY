        "    (\"Access control\", \"Confidentiality\", False),\n",
        "]\n",
        "\n",
        "violated = set()\n",
        "for name, principle, status in properties:\n",
        "    if status is False:\n",
        "        violated.add(principle)\n",
        "        print(f\"VIOLATION: {name} -> {principle}\")\n",
        "\n",
        "print(\"CIA principles violated:\", \", \".join(sorted(violated)) if violated else \"None\")\n"
