        "try:\n",
        "    from scapy.all import sniff\n",
        "except ImportError:\n",
        "    print(\"Scapy is not installed. Installing Scapy...\")\n",
        "    !pip install scapy\n",
        "    try:\n",
        "        from scapy.all import sniff\n",
        "    except ImportError:\n",
        "        print(\"Failed to install Scapy. Please try installing it manually with: pip install scapy\")\n",
        "        raise SystemExit(1)\n",
        "\n",
        "def show_packet(pkt):\n",
        "    print(pkt.summary())\n",
        "\n",
        "iface = input(\"Interface (press Enter for default): \").strip() or None\n",
        "count_text = input(\"Number of packets [10]: \").strip() or \"10\"\n",
        "try:\n",
        "    count = max(1, int(count_text))\n",
        "except ValueError:\n",
        "    count = 10\n",
        "\n",
        "print(\"Starting packet capture. Stop with Ctrl+C.\")\n",
        "try:\n",
        "    sniff(iface=iface, prn=show_packet, count=count, store=False)\n",
        "except PermissionError:\n",
        "    print(\"Permission denied. Run the program with appropriate packet-capture privileges.\")\n",
        "except OSError as e:\n",
        "    print(\"Capture error:\", e)\n"
