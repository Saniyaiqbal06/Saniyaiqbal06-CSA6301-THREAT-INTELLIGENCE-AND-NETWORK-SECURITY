      ],
      "source": [
        "from collections import Counter\n",
        "\n",
        "EVENTS = [\n",
        "    {\"user\":\"alice\",\"action\":\"login\",\"status\":\"success\",\"src_ip\":\"10.0.0.1\"},\n",
        "    {\"user\":\"bob\",\"action\":\"login\",\"status\":\"failed\",\"src_ip\":\"10.0.0.2\"},\n",
        "    {\"user\":\"bob\",\"action\":\"login\",\"status\":\"failed\",\"src_ip\":\"10.0.0.2\"},\n",
        "    {\"user\":\"alice\",\"action\":\"download\",\"status\":\"success\",\"src_ip\":\"10.0.0.1\"},\n",
        "    {\"user\":\"carol\",\"action\":\"login\",\"status\":\"success\",\"src_ip\":\"10.0.0.3\"},\n",
        "]\n",
        "\n",
        "field = input(\"Search field [action]: \").strip() or \"action\"\n",
        "value = input(\"Search value [login]: \").strip() or \"login\"\n",
        "matches = [e for e in EVENTS if str(e.get(field, \"\")).lower() == value.lower()]\n",
        "print(\"Search results:\")\n",
        "for e in matches:\n",
        "    print(e)\n",
        "\n",
        "stats_field = input(\"stats count BY field [user]: \").strip() or \"user\"\n",
        "counts = Counter(e.get(stats_field, \"unknown\") for e in EVENTS)\n",
        "print(\"Stats count by\", stats_field, \":\", dict(counts))\n"
      ]
    }
