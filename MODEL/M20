      ],
      "source": [
        "CATEGORIES = {\n",
        "    \"Phishing\": [\"phishing\", \"fake login\", \"credential\", \"malicious email\", \"attachment\", \"social engineering\"],\n",
        "    \"DoS/DDoS\": [\"denial of service\", \"ddos\", \"dos\", \"flood\", \"overwhelming requests\", \"traffic spike\"],\n",
        "    \"Malware\": [\"malware\", \"ransomware\", \"trojan\", \"worm\", \"virus\", \"payload\"],\n",
        "    \"Man-in-the-Middle\": [\"mitm\", \"man-in-the-middle\", \"arp spoof\", \"dns spoof\", \"intercept\", \"eavesdrop\"],\n",
        "}\n",
        "\n",
        "def classify(text):\n",
        "    t = text.lower()\n",
        "    scores = {c: sum(k in t for k in keys) for c, keys in CATEGORIES.items()}\n",
        "    return max(scores, key=scores.get)\n",
        "\n",
        "description = input(\"Incident description: \")\n",
        "print(\"Network threat category:\", classify(description))\n"
      ]
    }
