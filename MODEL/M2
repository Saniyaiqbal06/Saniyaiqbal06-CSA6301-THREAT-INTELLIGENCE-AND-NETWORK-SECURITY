      "source": [
        "import socket\n",
        "\n",
        "def scan_host(host, start_port=1, end_port=1024, timeout=0.2):\n",
        "    try:\n",
        "        ip = socket.gethostbyname(host)\n",
        "    except socket.gaierror:\n",
        "        print(\"Invalid/unresolvable host.\")\n",
        "        return\n",
        "    print(f\"Scanning {host} ({ip})...\")\n",
        "    open_ports = []\n",
        "    for port in range(start_port, end_port + 1):\n",
        "        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n",
        "            s.settimeout(timeout)\n",
        "            if s.connect_ex((ip, port)) == 0:\n",
        "                open_ports.append(port)\n",
        "                print(f\"OPEN: {port}\")\n",
        "    print(f\"Finished. Open ports: {open_ports}\")\n",
        "\n",
        "# Modified to use 'localhost' by default for demonstration\n",
        "host = 'localhost'\n",
        "scan_host(host)"
      ]
    }
