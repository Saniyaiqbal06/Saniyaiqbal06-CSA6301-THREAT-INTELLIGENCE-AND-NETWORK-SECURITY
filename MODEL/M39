      "source": [
        "from collections import defaultdict\n",
        "\n",
        "RAW_FEED = [\n",
        "    \"IP=198.51.100.20\",\n",
        "    \" domain = malicious.example \",\n",
        "    \"IP=203.0.113.55\",\n",
        "]\n",
        "\n",
        "INTERNAL_LOGS = [\n",
        "    {\"src_ip\":\"10.0.0.5\",\"dest_ip\":\"198.51.100.20\",\"event\":\"connection\"},\n",
        "    {\"src_ip\":\"10.0.0.8\",\"dest_ip\":\"8.8.8.8\",\"event\":\"connection\"},\n",
        "    {\"src_ip\":\"10.0.0.9\",\"domain\":\"malicious.example\",\"event\":\"dns\"},\n",
        "]\n",
        "\n",
        "def normalize(item):\n",
        "    item = item.strip()\n",
        "    if \"=\" not in item:\n",
        "        return None\n",
        "    kind, value = [x.strip().lower() for x in item.split(\"=\", 1)]\n",
        "    if kind in (\"ip\", \"domain\") and value:\n",
        "        return {\"type\": kind, \"value\": value}\n",
        "    return None\n",
        "\n",
        "iocs = [x for x in (normalize(v) for v in RAW_FEED) if x]\n",
        "print(\"Normalized IOCs:\", iocs)\n",
        "\n",
        "for ioc in iocs:\n",
        "    for log in INTERNAL_LOGS:\n",
        "        match = (ioc[\"type\"] == \"ip\" and log.get(\"dest_ip\") == ioc[\"value\"]) or \\\n",
        "                (ioc[\"type\"] == \"domain\" and log.get(\"domain\") == ioc[\"value\"])\n",
        "        if match:\n",
        "            print(\"TIP ALERT: IOC matched internal log ->\", ioc, log)\n"
      ]
    }
