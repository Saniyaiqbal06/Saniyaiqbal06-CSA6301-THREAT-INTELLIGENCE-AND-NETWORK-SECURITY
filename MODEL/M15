      ],
      "source": [
        "CATEGORIES = {\n",
        "    \"phishing\": [\"phishing\", \"fake email\", \"credential link\", \"malicious attachment\", \"social engineering\"],\n",
        "    \"unpatched vulnerability\": [\"unpatched\", \"missing patch\", \"vulnerable version\", \"cve\", \"security update\"],\n",
        "    \"misconfiguration\": [\"misconfiguration\", \"wrong permission\", \"open storage\", \"exposed port\", \"default password\"],\n",
        "    \"insider threat\": [\"insider\", \"employee\", \"contractor\", \"stole data\", \"intentional misuse\"],\n",
        "    \"supply-chain compromise\": [\"supplier\", \"third-party\", \"dependency\", \"vendor\", \"software update compromised\"],\n",
        "}\n",
        "\n",
        "def classify(text):\n",
        "    t = text.lower()\n",
        "    scores = {c: sum(k in t for k in keys) for c, keys in CATEGORIES.items()}\n",
        "    return max(scores, key=scores.get)\n",
        "\n",
        "narrative = input(\"Incident case-study narrative: \")\n",
        "print(\"Likely root cause:\", classify(narrative))\n"
      ]
    }
