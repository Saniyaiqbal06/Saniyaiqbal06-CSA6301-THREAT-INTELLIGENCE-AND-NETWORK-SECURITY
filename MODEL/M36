      ],
      "source": [
        "STANDARDS = {\n",
        "    \"PCI-DSS\": [\"payment card\", \"cardholder\", \"credit card\", \"debit card\", \"card data\", \"merchant\"],\n",
        "    \"HIPAA\": [\"patient\", \"health record\", \"protected health\", \"hospital\", \"medical\", \"healthcare\"],\n",
        "    \"GDPR\": [\"personal data\", \"eu resident\", \"european\", \"data subject\", \"privacy\", \"consent\"],\n",
        "    \"SOX\": [\"financial reporting\", \"public company\", \"audit controls\", \"financial records\", \"sox\"],\n",
        "}\n",
        "\n",
        "def classify(text):\n",
        "    t = text.lower()\n",
        "    scores = {s: sum(k in t for k in keys) for s, keys in STANDARDS.items()}\n",
        "    best = max(scores, key=scores.get)\n",
        "    return best if scores[best] else \"No clear match\"\n",
        "\n",
        "description = input(\"System/data description: \")\n",
        "print(\"Most likely compliance standard:\", classify(description))\n"
      ]
    }
  ]
