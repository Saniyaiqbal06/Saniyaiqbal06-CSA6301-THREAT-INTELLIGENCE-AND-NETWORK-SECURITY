        "import secrets\n",
        "\n",
        "def xor_stream(data, key):\n",
        "    # Educational stand-in only; real VPNs use authenticated modern cryptography.\n",
        "    out = bytearray()\n",
        "    for i, b in enumerate(data):\n",
        "        out.append(b ^ key[i % len(key)])\n",
        "    return bytes(out)\n",
        "\n",
        "message = input(\"Enter plaintext: \").encode()\n",
        "key = secrets.token_bytes(16)\n",
        "\n",
        "captured = xor_stream(message, key)\n",
        "print(\"Captured ciphertext:\", captured.hex())\n",
        "print(\"Readable without key:\", captured.decode(errors=\"replace\"))\n",
        "\n",
        "recovered = xor_stream(captured, key)\n",
        "print(\"Recovered with shared key:\", recovered.decode())\n"
      ]
