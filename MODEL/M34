      "source": [
        "DATASET = [\n",
        "    {\"ip\":\"10.0.0.5\",\"user\":\"alice\",\"event\":\"login\",\"indicator\":\"none\"},\n",
        "    {\"ip\":\"10.0.0.9\",\"user\":\"bob\",\"event\":\"powershell\",\"indicator\":\"suspicious\"},\n",
        "    {\"ip\":\"10.0.0.9\",\"user\":\"bob\",\"event\":\"download\",\"indicator\":\"malicious_ip\"},\n",
        "    {\"ip\":\"10.0.0.7\",\"user\":\"carol\",\"event\":\"login\",\"indicator\":\"none\"},\n",
        "]\n",
        "\n",
        "# 1. Hypothesis-based: start with a suspected behavior.\n",
        "hypothesis = [e for e in DATASET if e[\"event\"] == \"powershell\" and e[\"indicator\"] != \"none\"]\n",
        "\n",
        "# 2. Intelligence-based: search known indicators from an intelligence feed.\n",
        "known_iocs = {\"malicious_ip\"}\n",
        "intel_based = [e for e in DATASET if e[\"indicator\"] in known_iocs]\n",
        "\n",
        "# 3. Analytics-based: use a simple anomaly rule.\n",
        "from collections import Counter\n",
        "counts = Counter(e[\"ip\"] for e in DATASET)\n",
        "analytics_based = [e for e in DATASET if counts[e[\"ip\"]] >= 2]\n",
        "\n",
        "print(\"Hypothesis-based results:\", hypothesis)\n",
        "print(\"Intelligence-based results:\", intel_based)\n",
        "print(\"Analytics-based results:\", analytics_based)\n"
      ]
    }
