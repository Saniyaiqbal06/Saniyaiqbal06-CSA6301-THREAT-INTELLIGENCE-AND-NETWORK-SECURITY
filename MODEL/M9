      ],
      "source": [
        "STAGES = {\n",
        "    \"Direction\": [\"requirement\", \"priority\", \"question\", \"intelligence need\", \"objective\"],\n",
        "    \"Collection\": [\"collect\", \"gather\", \"feed\", \"source\", \"retrieve\", \"acquire\"],\n",
        "    \"Processing\": [\"normalize\", \"clean\", \"parse\", \"deduplicate\", \"convert\"],\n",
        "    \"Analysis\": [\"analyze\", \"correlate\", \"interpret\", \"assess\", \"pattern\"],\n",
        "    \"Dissemination\": [\"share\", \"report\", \"brief\", \"distribute\", \"deliver\"],\n",
        "    \"Feedback\": [\"feedback\", \"review\", \"improve\", \"refine\", \"response\"],\n",
        "}\n",
        "\n",
        "def classify(description):\n",
        "    t = description.lower()\n",
        "    scores = {stage: sum(k in t for k in keys) for stage, keys in STAGES.items()}\n",
        "    return max(scores, key=scores.get)\n",
        "\n",
        "description = input(\"Describe the intelligence-team activity: \")\n",
        "print(\"Lifecycle stage:\", classify(description))\n"
      ]
    }
