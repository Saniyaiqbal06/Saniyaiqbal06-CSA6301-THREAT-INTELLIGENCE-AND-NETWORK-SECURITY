          "text": [
            "{'protocol': 'TCP', 'port': 80, 'payload': 'normal text'} => NO ALERT\n",
            "{'protocol': 'UDP', 'port': 53, 'payload': 'malicious_payload'} => NO ALERT\n",
            "{'protocol': 'TCP', 'port': 80, 'payload': 'malicious_payload'} => ALERT: HTTP_TEST\n",
            "{'protocol': 'UDP', 'port': 53, 'payload': 'bad.example query'} => ALERT: DNS_TEST\n"
          ]
        }
      ],
      "source": [
        "SIGNATURES = [\n",
        "    {\"name\":\"HTTP_TEST\", \"protocol\":\"TCP\", \"port\":80, \"pattern\":\"malicious_payload\"},\n",
        "    {\"name\":\"DNS_TEST\", \"protocol\":\"UDP\", \"port\":53, \"pattern\":\"bad.example\"},\n",
        "]\n",
        "\n",
        "def detect(packet):\n",
        "    for sig in SIGNATURES:\n",
        "        if (packet.get(\"protocol\") == sig[\"protocol\"] and\n",
        "            packet.get(\"port\") == sig[\"port\"] and\n",
        "            sig[\"pattern\"].lower() in packet.get(\"payload\", \"\").lower()):\n",
        "            return f\"ALERT: {sig['name']}\"\n",
        "    return \"NO ALERT\"\n",
        "\n",
        "packets = [\n",
        "    {\"protocol\":\"TCP\",\"port\":80,\"payload\":\"normal text\"},\n",
        "    {\"protocol\":\"UDP\",\"port\":53,\"payload\":\"malicious_payload\"},\n",
        "    {\"protocol\":\"TCP\",\"port\":80,\"payload\":\"malicious_payload\"},\n",
        "    {\"protocol\":\"UDP\",\"port\":53,\"payload\":\"bad.example query\"},\n",
        "]\n",
        "\n",
        "for packet in packets:\n",
        "    print(packet, \"=>\", detect(packet))\n"
      ]
