      ],
      "source": [
        "PHASES = {\n",
        "    \"Preparation\": [\"prepare\", \"playbook\", \"training\", \"backup\", \"readiness\"],\n",
        "    \"Identification\": [\"detect\", \"alert\", \"identify\", \"investigate\", \"triage\"],\n",
        "    \"Containment\": [\"isolate\", \"block\", \"contain\", \"quarantine\", \"disable account\"],\n",
        "    \"Eradication\": [\"remove malware\", \"patch\", \"eradicate\", \"delete persistence\", \"clean\"],\n",
        "    \"Recovery\": [\"restore\", \"recover\", \"return to service\", \"rebuild\", \"validate\"],\n",
        "    \"Lessons Learned\": [\"lessons learned\", \"post-incident\", \"postmortem\", \"improvement\", \"review\"],\n",
        "}\n",
        "\n",
        "def classify(action):\n",
        "    t = action.lower()\n",
        "    scores = {p: sum(k in t for k in keys) for p, keys in PHASES.items()}\n",
        "    return max(scores, key=scores.get)\n",
        "\n",
        "action = input(\"Incident-response action description: \")\n",
        "print(\"Lifecycle phase:\", classify(action))\n"
      ]
    }
