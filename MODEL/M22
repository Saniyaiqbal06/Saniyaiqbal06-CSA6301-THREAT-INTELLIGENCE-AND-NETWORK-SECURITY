        "import re\n",
        "\n",
        "def detect_bruteforce(lines, target_user):\n",
        "    failed = 0\n",
        "    for line in lines:\n",
        "        m = re.search(r\"user=(\\S+)\\s+status=(\\S+)\", line, re.I)\n",
        "        if not m:\n",
        "            continue\n",
        "        user, status = m.groups()\n",
        "        if user != target_user:\n",
        "            continue\n",
        "        if status.lower() == \"failed\":\n",
        "            failed += 1\n",
        "        elif status.lower() == \"success\" and failed > 0:\n",
        "            return True, failed\n",
        "    return False, failed\n",
        "\n",
        "path = input(\"Authentication log file path: \").strip()\n",
        "user = input(\"User account to check: \").strip()\n",
        "try:\n",
        "    with open(path, encoding=\"utf-8\") as f:\n",
        "        lines = f.readlines()\n",
        "    detected, count = detect_bruteforce(lines, user)\n",
        "    print(\"BRUTE-FORCE PATTERN DETECTED\" if detected else \"No brute-force pattern detected\",\n",
        "          f\"(failed attempts before success: {count})\")\n",
        "except OSError as e:\n",
        "    print(\"Could not read log:\", e)\n"
      ]
