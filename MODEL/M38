        "def risk_score(likelihood, impact):\n",
        "    score = likelihood * impact\n",
        "    if score <= 4:\n",
        "        level = \"Low\"\n",
        "    elif score <= 9:\n",
        "        level = \"Medium\"\n",
        "    elif score <= 16:\n",
        "        level = \"High\"\n",
        "    else:\n",
        "        level = \"Critical\"\n",
        "    return score, level\n",
        "\n",
        "try:\n",
        "    likelihood = int(input(\"Likelihood (1-5): \"))\n",
        "    impact = int(input(\"Impact (1-5): \"))\n",
        "    if not 1 <= likelihood <= 5 or not 1 <= impact <= 5:\n",
        "        raise ValueError\n",
        "    score, level = risk_score(likelihood, impact)\n",
        "    print(\"Risk score:\", score)\n",
        "    print(\"Risk level:\", level)\n",
        "except ValueError:\n",
        "    print(\"Enter whole numbers from 1 to 5.\")\n"
      ]
    }
