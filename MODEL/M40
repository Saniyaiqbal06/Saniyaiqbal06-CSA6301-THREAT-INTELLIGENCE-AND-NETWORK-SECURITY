      "source": [
        "TOOLS = {\n",
        "    \"Wireshark\": [\"packet\", \"pcap\", \"network traffic\", \"protocol analysis\", \"sniff\"],\n",
        "    \"Nmap\": [\"port scan\", \"open ports\", \"network discovery\", \"host discovery\"],\n",
        "    \"Splunk\": [\"siem\", \"search logs\", \"correlation\", \"dashboard\", \"event analysis\"],\n",
        "    \"Burp Suite\": [\"web application\", \"http\", \"proxy\", \"web security\", \"request\"],\n",
        "    \"Nessus\": [\"vulnerability\", \"vulnerability assessment\", \"scan\", \"weakness\"],\n",
        "    \"YARA\": [\"malware\", \"file signature\", \"pattern matching\", \"malware classification\"],\n",
        "    \"Metasploit\": [\"penetration testing\", \"exploit validation\", \"exploit\", \"security testing\"],\n",
        "    \"ELK Stack\": [\"log management\", \"elasticsearch\", \"kibana\", \"logstash\", \"log analytics\"],\n",
        "}\n",
        "\n",
        "def recommend(task):\n",
        "    t = task.lower()\n",
        "    scores = {tool: sum(k in t for k in keys) for tool, keys in TOOLS.items()}\n",
        "    best = max(scores, key=scores.get)\n",
        "    return best if scores[best] else \"No strong match; describe the task more specifically.\"\n",
        "\n",
        "task = input(\"Plain-English security task: \")\n",
        "print(\"Recommended tool:\", recommend(task))\n"
      ]
