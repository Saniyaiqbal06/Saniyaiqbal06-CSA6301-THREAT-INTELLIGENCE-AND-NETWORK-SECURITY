      "source": [
        "def simulate(attack_success, controls):\n",
        "    blocked_by = []\n",
        "    for control, effectiveness in controls:\n",
        "        if attack_success > effectiveness:\n",
        "            print(f\"{control}: bypassed\")\n",
        "            attack_success -= effectiveness\n",
        "        else:\n",
        "            print(f\"{control}: BLOCKED the attack\")\n",
        "            blocked_by.append(control)\n",
        "            return blocked_by\n",
        "    return blocked_by\n",
        "\n",
        "controls = [\n",
        "    (\"Firewall\", 0.20),\n",
        "    (\"Network IDS/IPS\", 0.25),\n",
        "    (\"Endpoint Protection\", 0.25),\n",
        "    (\"Access Control\", 0.20),\n",
        "    (\"Monitoring/Response\", 0.15),\n",
        "]\n",
        "\n",
        "print(\"Defense-in-Depth simulation:\")\n",
        "blocked = simulate(0.75, controls)\n",
        "print(\"Protection result:\", \"Attack stopped by layered controls.\" if blocked else \"Attack passed all modeled layers.\")\n"
      ]
    }
