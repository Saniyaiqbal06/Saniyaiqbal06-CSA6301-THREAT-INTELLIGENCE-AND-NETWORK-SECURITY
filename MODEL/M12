      "source": [
        "def priority(alert):\n",
        "    t = alert.lower()\n",
        "    if any(x in t for x in [\"ransomware\", \"data exfiltration\", \"active breach\", \"domain admin\", \"critical server compromised\"]):\n",
        "        return \"P1\"\n",
        "    if any(x in t for x in [\"malware detected\", \"multiple failed logins\", \"privilege escalation\", \"suspicious powershell\"]):\n",
        "        return \"P2\"\n",
        "    if any(x in t for x in [\"single failed login\", \"port scan\", \"policy violation\", \"suspicious login\"]):\n",
        "        return \"P3\"\n",
        "    return \"P4\"\n",
        "\n",
        "alert = input(\"SOC alert description: \")\n",
        "print(\"Priority:\", priority(alert))\n"
      ]
