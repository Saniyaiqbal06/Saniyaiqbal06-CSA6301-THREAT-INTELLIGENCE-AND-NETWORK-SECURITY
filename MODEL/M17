            "Describe the security control: ROLES\n",
            "Most likely ISO/IEC 27001:2022 Annex A domain: Organizational Controls\n"
          ]
        }
      ],
      "source": [
        "DOMAINS = {\n",
        "    \"Organizational Controls\": [\"policy\", \"roles\", \"supplier\", \"threat intelligence\", \"information security\"],\n",
        "    \"People Controls\": [\"training\", \"awareness\", \"employee\", \"disciplinary\", \"remote working\"],\n",
        "    \"Physical Controls\": [\"physical\", \"office\", \"entry\", \"door\", \"visitor\", \"equipment\"],\n",
        "    \"Technological Controls\": [\"firewall\", \"malware\", \"backup\", \"logging\", \"encryption\", \"access control\", \"network\"],\n",
        "}\n",
        "\n",
        "def classify(description):\n",
        "    t = description.lower()\n",
        "    scores = {d: sum(k in t for k in keys) for d, keys in DOMAINS.items()}\n",
        "    return max(scores, key=scores.get)\n",
        "\n",
        "description = input(\"Describe the security control: \")\n",
        "print(\"Most likely ISO/IEC 27001:2022 Annex A domain:\", classify(description))\n"
      ]
    }
  ]
