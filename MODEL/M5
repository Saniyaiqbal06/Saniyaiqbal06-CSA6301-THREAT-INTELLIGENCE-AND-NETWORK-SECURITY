            "Threat-intelligence report description: report the alert you say in an report\n",
            "Intended audience: incident\n",
            "Classification: Operational\n"
          ]
        }
      ],
      "source": [
        "def classify(report, audience):\n",
        "    text = (report + \" \" + audience).lower()\n",
        "    operational = [\"soc\", \"analyst\", \"incident\", \"ioc\", \"alert\", \"immediately\", \"investigate\", \"triage\"]\n",
        "    tactical = [\"threat actor\", \"ttp\", \"mitre\", \"technique\", \"detection\", \"hunt\", \"defender\"]\n",
        "    strategic = [\"executive\", \"board\", \"ciso\", \"risk\", \"investment\", \"business impact\", \"leadership\"]\n",
        "    scores = {\n",
        "        \"Operational\": sum(x in text for x in operational),\n",
        "        \"Tactical\": sum(x in text for x in tactical),\n",
        "        \"Strategic\": sum(x in text for x in strategic),\n",
        "    }\n",
        "    return max(scores, key=scores.get)\n",
        "\n",
        "report = input(\"Threat-intelligence report description: \")\n",
        "audience = input(\"Intended audience: \")\n",
        "print(\"Classification:\", classify(report, audience))\n",
        "\n"
      ]
    }
