      "source": [
        "from collections import Counter\n",
        "from datetime import datetime\n",
        "\n",
        "LOGS = [\n",
        "    \"2026-08-28T09:00:01 192.0.2.10 GET /\",\n",
        "    \"2026-08-28T09:00:02 192.0.2.10 GET /login\",\n",
        "    \"2026-08-28T09:00:03 192.0.2.10 GET /api\",\n",
        "    \"2026-08-28T09:00:04 192.0.2.10 GET /\",\n",
        "    \"2026-08-28T09:00:05 192.0.2.10 GET /admin\",\n",
        "    \"2026-08-28T09:00:06 192.0.2.10 GET /data\",\n",
        "    \"2026-08-28T09:00:07 192.0.2.20 GET /\",\n",
        "]\n",
        "\n",
        "def detect(logs, threshold=5):\n",
        "    counts = Counter(line.split()[1] for line in logs if len(line.split()) >= 2)\n",
        "    return [(ip, n) for ip, n in counts.items() if n > threshold]\n",
        "\n",
        "for ip, count in detect(LOGS):\n",
        "    print(f\"Possible DoS source: {ip} generated {count} requests\")\n"
      ]
    }
