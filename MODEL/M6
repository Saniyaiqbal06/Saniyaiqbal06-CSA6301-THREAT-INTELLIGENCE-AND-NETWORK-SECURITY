      "source": [
        "import re\n",
        "import ipaddress\n",
        "from urllib.parse import urlparse\n",
        "\n",
        "SUSPICIOUS_WORDS = [\"login\", \"verify\", \"verification\", \"password\", \"secure\", \"account\",\n",
        "                    \"update\", \"confirm\", \"wallet\", \"payment\", \"signin\"]\n",
        "\n",
        "def analyze_url(url):\n",
        "    if not re.match(r\"^[a-zA-Z][a-zA-Z0-9+.-]*://\", url):\n",
        "        url = \"http://\" + url\n",
        "    p = urlparse(url)\n",
        "    host = p.hostname or \"\"\n",
        "    indicators = []\n",
        "\n",
        "    try:\n",
        "        ipaddress.ip_address(host)\n",
        "        indicators.append(\"IP address used as domain\")\n",
        "    except ValueError:\n",
        "        pass\n",
        "\n",
        "    if len(host.split(\".\")) >= 4:\n",
        "        indicators.append(\"Excessive subdomains\")\n",
        "\n",
        "    if any(word in url.lower() for word in SUSPICIOUS_WORDS):\n",
        "        indicators.append(\"Suspicious keyword\")\n",
        "    if \"@\" in url:\n",
        "        indicators.append(\"@ symbol can hide the real destination\")\n",
        "    if len(url) > 150:\n",
        "        indicators.append(\"Unusually long URL\")\n",
        "    if p.scheme.lower() != \"https\":\n",
        "        indicators.append(\"Not using HTTPS\")\n",
        "\n",
        "    return indicators\n",
        "\n",
        "url = input(\"Enter URL: \").strip()\n",
        "findings = analyze_url(url)\n",
        "print(\"POSSIBLE PHISHING\" if findings else \"No common phishing indicators detected\")\n",
        "for f in findings:\n",
        "    print(\"-\", f)\n"
      ]
