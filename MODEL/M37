      "source": [
        "import time\n",
        "from collections import Counter, deque\n",
        "\n",
        "events = [\n",
        "    {\"user\":\"alice\",\"ip\":\"10.0.0.1\",\"status\":\"success\"},\n",
        "    {\"user\":\"alice\",\"ip\":\"10.0.0.1\",\"status\":\"success\"},\n",
        "    {\"user\":\"bob\",\"ip\":\"203.0.113.10\",\"status\":\"failed\"},\n",
        "    {\"user\":\"bob\",\"ip\":\"203.0.113.10\",\"status\":\"failed\"},\n",
        "    {\"user\":\"bob\",\"ip\":\"203.0.113.10\",\"status\":\"failed\"},\n",
        "    {\"user\":\"bob\",\"ip\":\"203.0.113.10\",\"status\":\"failed\"},\n",
        "]\n",
        "\n",
        "baseline = {\"max_failed_logins_in_window\": 3}\n",
        "window = deque(maxlen=5)\n",
        "\n",
        "for event in events:\n",
        "    window.append(event)\n",
        "    failed = Counter(e[\"user\"] for e in window if e[\"status\"] == \"failed\")\n",
        "    for user, count in failed.items():\n",
        "        if count > baseline[\"max_failed_logins_in_window\"]:\n",
        "            print(f\"ANOMALY: {user} has {count} failed logins in the monitoring window\")\n",
        "    print(\"Processed:\", event)\n",
        "    time.sleep(0.1)\n"
      ]
    }
