      "source": [
        "BASELINE = {\n",
        "    \"mfa\": True,\n",
        "    \"endpoint_protection\": True,\n",
        "    \"logging\": True,\n",
        "    \"encrypted_storage\": True,\n",
        "    \"backup\": True,\n",
        "    \"patch_compliance_percent\": 95,\n",
        "}\n",
        "\n",
        "CURRENT = {\n",
        "    \"mfa\": True,\n",
        "    \"endpoint_protection\": False,\n",
        "    \"logging\": True,\n",
        "    \"encrypted_storage\": True,\n",
        "    \"backup\": True,\n",
        "    \"patch_compliance_percent\": 87,\n",
        "}\n",
        "\n",
        "def check(current, baseline):\n",
        "    failures = []\n",
        "    for key, minimum in baseline.items():\n",
        "        value = current.get(key)\n",
        "        if isinstance(minimum, bool):\n",
        "            if value is not True:\n",
        "                failures.append(f\"{key}: required {minimum}, found {value}\")\n",
        "        elif value is None or value < minimum:\n",
        "            failures.append(f\"{key}: minimum {minimum}, found {value}\")\n",
        "    return failures\n",
        "\n",
        "failures = check(CURRENT, BASELINE)\n",
        "print(\"Baseline failures:\")\n",
        "for x in failures:\n",
        "    print(\"-\", x)\n",
        "if not failures:\n",
        "    print(\"All controls meet the baseline.\")\n"
      ]
    }
