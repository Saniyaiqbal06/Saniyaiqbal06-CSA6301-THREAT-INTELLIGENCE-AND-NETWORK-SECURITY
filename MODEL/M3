      "source": [
        "REQUIRED = {\n",
        "    \"scope\": [\"scope\", \"applicability\", \"covered systems\"],\n",
        "    \"roles and responsibilities\": [\"roles and responsibilities\", \"responsibilities\", \"security roles\"],\n",
        "    \"enforcement\": [\"enforcement\", \"disciplinary\", \"violations\", \"non-compliance\"],\n",
        "    \"review cycle\": [\"review cycle\", \"review annually\", \"review every\", \"periodic review\"],\n",
        "    \"approval authority\": [\"approval authority\", \"approved by\", \"policy owner\", \"approver\"],\n",
        "}\n",
        "\n",
        "def check_policy(text):\n",
        "    t = text.lower()\n",
        "    missing = [name for name, terms in REQUIRED.items()\n",
        "               if not any(term in t for term in terms)]\n",
        "    return missing\n",
        "\n",
        "path = input(\"Policy text file path (or press Enter for pasted text): \").strip()\n",
        "if path:\n",
        "    try:\n",
        "        text = open(path, encoding=\"utf-8\").read()\n",
        "    except OSError as e:\n",
        "        print(\"Could not read file:\", e)\n",
        "        text = \"\"\n",
        "else:\n",
        "    text = input(\"Paste policy text: \")\n",
        "\n",
        "missing = check_policy(text)\n",
        "if missing:\n",
        "    print(\"Missing governance elements:\")\n",
        "    for item in missing:\n",
        "        print(\"-\", item)\n",
        "else:\n",
        "    print(\"All required governance elements were found.\")\n"
      ]
    }
