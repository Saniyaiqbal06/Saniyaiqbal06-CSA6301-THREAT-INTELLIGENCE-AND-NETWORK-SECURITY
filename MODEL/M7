      "source": [
        "import re\n",
        "from collections import Counter\n",
        "\n",
        "RAW_LOGS = [\n",
        "    \"2026-08-28 09:10:01 INFO user=alice ip=10.0.0.5 action=login status=success\",\n",
        "    \"2026-08-28 09:10:05 WARN user=bob ip=10.0.0.8 action=login status=failed\",\n",
        "    \"2026-08-28 09:10:06 WARN user=bob ip=10.0.0.8 action=login status=failed\",\n",
        "    \"2026-08-28 09:10:07 INFO user=bob ip=10.0.0.8 action=login status=success\",\n",
        "]\n",
        "\n",
        "def parse(line):\n",
        "    event = {}\n",
        "    first, *rest = line.split()\n",
        "    event[\"timestamp\"] = first + \" \" + rest.pop(0)\n",
        "    event[\"level\"] = rest.pop(0)\n",
        "    for token in rest:\n",
        "        if \"=\" in token:\n",
        "            k, v = token.split(\"=\", 1)\n",
        "            event[k] = v\n",
        "    return event\n",
        "\n",
        "events = [parse(x) for x in RAW_LOGS]       # Logstash-style parsing\n",
        "index = {str(i): e for i, e in enumerate(events)}  # Elasticsearch-style index\n",
        "\n",
        "status_counts = Counter(e.get(\"status\", \"unknown\") for e in index.values())  # Kibana-style aggregation\n",
        "user_counts = Counter(e.get(\"user\", \"unknown\") for e in index.values())\n",
        "\n",
        "print(\"Indexed events:\")\n",
        "for k, v in index.items():\n",
        "    print(k, v)\n",
        "print(\"\\nStatus counts:\", dict(status_counts))\n",
        "print(\"User counts:\", dict(user_counts))\n"
      ]
    }
