            "{'direction': 'OUTBOUND', 'src': '10.0.0.10', 'sport': 50000, 'dst': '8.8.8.8', 'dport': 53} => PERMIT (outbound connection recorded)\n",
            "{'direction': 'INBOUND', 'src': '8.8.8.8', 'sport': 53, 'dst': '10.0.0.10', 'dport': 50000} => PERMIT (return traffic for established connection)\n",
            "{'direction': 'INBOUND', 'src': '203.0.113.50', 'sport': 4444, 'dst': '10.0.0.10', 'dport': 22} => BLOCK (unsolicited inbound traffic)\n"
          ]
        }
      ],
      "source": [
        "allowed_connections = set()\n",
        "\n",
        "def process(packet):\n",
        "    direction = packet[\"direction\"]\n",
        "    flow = (packet[\"src\"], packet[\"sport\"], packet[\"dst\"], packet[\"dport\"])\n",
        "    reverse = (packet[\"dst\"], packet[\"dport\"], packet[\"src\"], packet[\"sport\"])\n",
        "\n",
        "    if direction == \"OUTBOUND\":\n",
        "        allowed_connections.add(flow)\n",
        "        return \"PERMIT (outbound connection recorded)\"\n",
        "    if direction == \"INBOUND\" and reverse in allowed_connections:\n",
        "        return \"PERMIT (return traffic for established connection)\"\n",
        "    return \"BLOCK (unsolicited inbound traffic)\"\n",
        "\n",
        "packets = [\n",
        "    {\"direction\":\"OUTBOUND\", \"src\":\"10.0.0.10\",\"sport\":50000,\"dst\":\"8.8.8.8\",\"dport\":53},\n",
        "    {\"direction\":\"INBOUND\",  \"src\":\"8.8.8.8\",\"sport\":53,\"dst\":\"10.0.0.10\",\"dport\":50000},\n",
        "    {\"direction\":\"INBOUND\",  \"src\":\"203.0.113.50\",\"sport\":4444,\"dst\":\"10.0.0.10\",\"dport\":22},\n",
        "]\n",
        "\n",
        "for p in packets:\n",
        "    print(p, \"=>\", process(p))\n"
      ]
