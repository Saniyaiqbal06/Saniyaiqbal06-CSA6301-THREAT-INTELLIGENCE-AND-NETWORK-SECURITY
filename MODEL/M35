      "source": [
        "REQUIRED_BY_ROLE = {\n",
        "    \"analyst\": {\"read_logs\", \"create_ticket\"},\n",
        "    \"developer\": {\"read_code\", \"deploy_test\"},\n",
        "    \"admin\": {\"read_logs\", \"manage_users\", \"backup_restore\"},\n",
        "}\n",
        "\n",
        "ACCOUNTS = {\n",
        "    \"alice\": (\"analyst\", {\"read_logs\", \"create_ticket\"}),\n",
        "    \"bob\": (\"developer\", {\"read_code\", \"deploy_test\", \"manage_users\"}),\n",
        "    \"carol\": (\"admin\", {\"read_logs\", \"manage_users\", \"backup_restore\"}),\n",
        "}\n",
        "\n",
        "for user, (role, permissions) in ACCOUNTS.items():\n",
        "    required = REQUIRED_BY_ROLE.get(role, set())\n",
        "    excess = permissions - required\n",
        "    missing = required - permissions\n",
        "    if excess:\n",
        "        print(f\"{user}: EXCESS ACCESS -> {sorted(excess)}\")\n",
        "    else:\n",
        "        print(f\"{user}: no excess access\")\n",
        "    if missing:\n",
        "        print(f\"       missing required permissions -> {sorted(missing)}\")\n"
      ]
    }
  ]
