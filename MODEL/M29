            "Security incident description: HI, IAM HERE\n",
            "Recommended containment: Use scoped network isolation, preserve evidence, restrict affected accounts, and investigate before broad eradication.\n"
          ]
        }
      ],
      "source": [
        "RULES = [\n",
        "    (\"ransomware\", \"Isolate affected endpoints immediately; preserve evidence; disable compromised credentials.\"),\n",
        "    (\"data exfiltration\", \"Block suspicious egress; isolate affected host; revoke exposed credentials.\"),\n",
        "    (\"phishing\", \"Quarantine the message; reset compromised credentials; block malicious indicators.\"),\n",
        "    (\"malware\", \"Isolate infected endpoint; preserve evidence; remove malicious persistence.\"),\n",
        "    (\"ddos\", \"Activate DDoS protection; rate-limit traffic; coordinate with ISP/CDN.\"),\n",
        "    (\"insider\", \"Restrict affected account access; preserve audit logs; involve authorized management.\"),\n",
        "]\n",
        "\n",
        "def recommend(description):\n",
        "    t = description.lower()\n",
        "    for keyword, action in RULES:\n",
        "        if keyword in t:\n",
        "            return action\n",
        "    return \"Use scoped network isolation, preserve evidence, restrict affected accounts, and investigate before broad eradication.\"\n",
        "\n",
        "description = input(\"Security incident description: \")\n",
        "print(\"Recommended containment:\", recommend(description))\n"
      ]
