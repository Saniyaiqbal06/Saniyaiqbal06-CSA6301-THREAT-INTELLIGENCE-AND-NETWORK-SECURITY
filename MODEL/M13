      ],
      "source": [
        "def assess(data):\n",
        "    required = [\"context\", \"confidence\", \"actionability\"]\n",
        "    missing = [x for x in required if not data.get(x)]\n",
        "    if missing:\n",
        "        return \"RAW/UNPROCESSED DATA\", missing\n",
        "    try:\n",
        "        confidence = float(data[\"confidence\"])\n",
        "    except ValueError:\n",
        "        return \"RAW/UNPROCESSED DATA\", [\"confidence must be numeric\"]\n",
        "    if not 0 <= confidence <= 100:\n",
        "        return \"RAW/UNPROCESSED DATA\", [\"confidence must be 0-100\"]\n",
        "    return (\"GENUINE THREAT INTELLIGENCE\", []) if data[\"actionability\"].strip() else (\"RAW/UNPROCESSED DATA\", [\"actionability\"])\n",
        "\n",
        "data = {\n",
        "    \"indicator\": input(\"Collected indicator/data: \"),\n",
        "    \"context\": input(\"Context (who/what/when/where): \"),\n",
        "    \"confidence\": input(\"Confidence 0-100: \"),\n",
        "    \"actionability\": input(\"Actionability (what can defenders do?): \"),\n",
        "}\n",
        "result, issues = assess(data)\n",
        "print(result)\n",
        "if issues:\n",
        "    print(\"Missing/invalid:\", \", \".join(issues))\n"
      ]
    }
